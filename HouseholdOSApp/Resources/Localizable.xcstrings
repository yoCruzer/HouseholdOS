{
  "sourceLanguage" : "en",
  "strings" : {
    "A formal item only requires a name. Photos, category, location and notes stay optional." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "正式物品只需要名称。照片、分类、位置和备注均为可选。" } } } },
    "A name is required only when you move this draft to the library." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "只有将草稿移入物品库时才需要名称。" } } } },
