    "Start with a photo or an empty draft. You can fill in the details later." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "从照片或空白草稿开始。你可以稍后补充详细信息。" } } } },
    "Start without a photo" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "不添加照片开始" } } } },
