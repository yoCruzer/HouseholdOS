    "Camera access is unavailable. Choose a photo or start without one." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "无法使用相机。请选择照片或不添加照片继续。" } } } },
    "Camera access is unavailable. You can use Photos instead." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "无法使用相机。你可以改用照片。" } } } },
    "Camera access is unavailable. You can use Photos or continue without one." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "无法使用相机。你可以使用照片或不添加照片继续。" } } } },
