    "Take Photo" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "拍照" } } } },
    "The back camera is unavailable on this device." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "此设备没有可用的后置相机。" } } } },
    "The camera could not be prepared." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "无法准备相机。" } } } },
    "The captured photo was not valid JPEG data." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "拍摄的照片不是有效的 JPEG 数据。" } } } },
    "The draft record was deleted, but some local photo files could not be removed. HouseholdOS will retry during later maintenance or the next launch. There is no manual maintenance control at this time." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "草稿记录已删除，但部分本地照片文件无法移除。HouseholdOS 会在后续维护或下次启动时重试。目前没有手动维护入口。" } } } },
    "The draft was saved, but the photo could not be added." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "草稿已保存，但无法添加照片。" } } } },
    "The item record was deleted, but some local photo files could not be removed. HouseholdOS will retry during later maintenance or the next launch. There is no manual maintenance control at this time." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "物品记录已删除，但部分本地照片文件无法移除。HouseholdOS 会在后续维护或下次启动时重试。目前没有手动维护入口。" } } } },
    "The local library is unavailable. Your files were not deleted." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "本地物品库不可用。你的文件没有被删除。" } } } },
    "The media import failed, and its staging file could not be removed." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "媒体导入失败，而且暂存文件无法移除。" } } } },
    "The original photo could not be opened." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "无法打开原始照片。" } } } },
    "The photo could not be captured." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "无法拍摄照片。" } } } },
    "The photo record was deleted, but some local photo files remain. HouseholdOS will retry them during later maintenance or the next launch." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "照片记录已删除，但仍有部分本地照片文件。HouseholdOS 会在后续维护或下次启动时重试。" } } } },
    "The saved library could not be refreshed." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "无法刷新已保存的物品库。" } } } },
    "The selected image could not be copied." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "无法复制所选图像。" } } } },
    "The selected image could not be read." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "无法读取所选图像。" } } } },
    "This camera cannot deliver a JPEG photo." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "此相机无法提供 JPEG 照片。" } } } },
    "This draft no longer exists." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "此草稿已不存在。" } } } },
    "This item no longer exists." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "此物品已不存在。" } } } },
    "This photo no longer exists." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "此照片已不存在。" } } } },
    "Tools" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "工具" } } } },
